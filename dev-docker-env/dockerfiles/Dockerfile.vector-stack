FROM qdrant/qdrant:v1.16.3

USER root

RUN apt-get update && apt-get install -y --no-install-recommends \
      curl \
      git \
      ca-certificates \
      nodejs \
      npm \
      python3 \
      build-essential \
      jq \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/qdrant-mcp-server
RUN npm init -y \
    && npm install @mhalder/qdrant-mcp-server@^3.3.5

WORKDIR /opt/better-qdrant
RUN npm init -y \
    && npm install better-qdrant-mcp-server@^0.1.1

WORKDIR /opt/aperio
RUN git clone --depth 1 https://github.com/baiganio/aperio.git . \
    && npm install \
    && sed -i 's/logger\.warning(/logger.warn(/g' db/index.js

RUN printf '%s\n' \
      '#!/bin/sh' \
      'set -eu' \
      'export EMBEDDING_PROVIDER="${EMBEDDING_PROVIDER:-ollama}"' \
      'export EMBEDDING_BASE_URL="${EMBEDDING_BASE_URL:-http://host.docker.internal:11434}"' \
      'export EMBEDDING_MODEL="${EMBEDDING_MODEL:-nomic-embed-text:v1.5}"' \
      'export CODE_CHUNK_SIZE="${CODE_CHUNK_SIZE:-1500}"' \
      'exec node /opt/qdrant-mcp-server/node_modules/@mhalder/qdrant-mcp-server/build/index.js' \
      > /usr/local/bin/mcp-qdrant \
    && printf '%s\n' \
      '#!/bin/sh' \
      'set -eu' \
      'export DEFAULT_EMBEDDING_SERVICE="${DEFAULT_EMBEDDING_SERVICE:-ollama}"' \
      'export OLLAMA_ENDPOINT="${OLLAMA_ENDPOINT:-http://host.docker.internal:11434}"' \
      'export OLLAMA_MODEL="${OLLAMA_MODEL:-nomic-embed-text:v1.5}"' \
      'exec node /opt/better-qdrant/node_modules/better-qdrant-mcp-server/build/index.js' \
      > /usr/local/bin/mcp-better-qdrant \
    && printf '%s\n' \
      '#!/bin/sh' \
      'set -eu' \
      'export EMBEDDING_PROVIDER="${EMBEDDING_PROVIDER:-transformers}"' \
      'export OLLAMA_MODEL="${OLLAMA_MODEL:-qwen2.5:3b}"' \
      'export OLLAMA_BASE_URL="${OLLAMA_BASE_URL:-http://host.docker.internal:11434}"' \
      'export APERIO_ALLOWED_PATHS_TO_READ="${APERIO_ALLOWED_PATHS_TO_READ:-/workspace}"' \
      'export APERIO_ALLOWED_PATHS_TO_WRITE="${APERIO_ALLOWED_PATHS_TO_WRITE:-/workspace}"' \
      'export DB_BACKEND="${DB_BACKEND:-postgres}"' \
      'export DATABASE_URL="${DATABASE_URL:-postgresql://aperio:aperio_local@postgres:5432/aperio}"' \
      'export PGHOST="${PGHOST:-postgres}"' \
      'export PGPORT="${PGPORT:-5432}"' \
      'export PGDATABASE="${PGDATABASE:-aperio}"' \
      'export PGUSER="${PGUSER:-aperio}"' \
      'export PGPASSWORD="${PGPASSWORD:-aperio_local}"' \
      'exec node /opt/aperio/mcp/index.js' \
      > /usr/local/bin/mcp-aperio \
    && chmod +x /usr/local/bin/mcp-qdrant /usr/local/bin/mcp-better-qdrant /usr/local/bin/mcp-aperio

COPY scripts/vector-stack-entrypoint.sh /qdrant/vector-stack-entrypoint.sh
RUN chmod +x /qdrant/vector-stack-entrypoint.sh

WORKDIR /qdrant
CMD ["/qdrant/vector-stack-entrypoint.sh"]
