# Local-only overrides for the AI dev tooling stack.
# Copy this file to .env if you need local developer-specific values.

# Rancher Desktop, Lima, Podman, or other non-standard Docker runtimes may need
# this set to the host LAN IP. Leave unset for Docker Engine/Desktop host-gateway.
OLLAMA_HOST_IP=

# Workspace path precedence used by start.sh:
# 1. WORKSPACE_PATH in this file
# 2. workspace_path in .nsv
# 3. REPOSITORY_ROOT in this file
# 4. repository_root in .nsv
# 5. repository root
# 6. ${HOME}/projects
WORKSPACE_PATH=
REPOSITORY_ROOT=

# qdrant-mcp-server and better-qdrant-mcp-server defaults.
EMBEDDING_PROVIDER=ollama
EMBEDDING_BASE_URL=http://host.docker.internal:11434
EMBEDDING_MODEL=nomic-embed-text:v1.5
OLLAMA_ENDPOINT=http://host.docker.internal:11434
OLLAMA_MODEL=nomic-embed-text:v1.5
CODE_CHUNK_SIZE=1500

# Aperio defaults.
APERIO_OLLAMA_MODEL=qwen2.5:3b
APERIO_OLLAMA_BASE_URL=http://host.docker.internal:11434
DB_BACKEND=postgres
DATABASE_URL=postgresql://aperio:aperio_local@postgres:5432/aperio
PGHOST=postgres
PGPORT=5432
PGDATABASE=aperio
PGUSER=aperio
PGPASSWORD=aperio_local

# Optional mxbai-embed-large evaluation path. Use a separate 1024-dimensional
# Qdrant collection and stricter chunking if this is enabled.
MXBAI_EMBEDDING_MODEL=mxbai-embed-large
MXBAI_CODE_CHUNK_SIZE=1000
